<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前台服务：保证倒计时在后台/熄屏时继续运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ 前台服务通知需要用户授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确定时权限。
         targetSdk 停在 32（为了能开关蓝牙），此时 USE_EXACT_ALARM 不生效，
         改用 SCHEDULE_EXACT_ALARM：targetSdk < 33 的安装包默认授予，无需用户手动开启。
         锁屏后设备进 Doze、CPU 休眠，且 MIUI 会禁用第三方应用的唤醒锁，
         这时只能靠精确闹钟准时唤醒来执行暂停。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 到点时唤醒 CPU 执行暂停操作 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 开机后重新排上「自动关闭应用」的闹钟（重启会清空系统里的所有闹钟） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 蓝牙：关闭/开启系统蓝牙用于「停止播放后自动关蓝牙」。
         targetSdk 停在 32，所以 Android 13+ 上 enable()/disable() 仍然可用；
         Android 12+ 的动态权限是 BLUETOOTH_CONNECT（「附近的设备」）。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- 允许引导用户把本应用加入电池优化白名单。
         MIUI/HyperOS 的 greeze 会冻结第三方应用并禁用其唤醒锁，导致熄屏后无法准点执行暂停，
         只有加入白名单后系统才不会冻结进程。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioPauseTimer"
        tools:targetApi="34">

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AudioPauseTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 倒计时前台服务 -->
        <service
            android:name=".CountdownService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="倒计时结束后暂停设备上其它应用正在播放的媒体音频" />
        </service>

        <!-- 媒体会话监听：获取系统里所有正在播放的媒体（必须由用户在设置里授权） -->
        <service
            android:name=".MediaListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 自动关闭闹钟的到点入口：闹钟由本应用自己创建并显式指名，不需要对外导出 -->
        <receiver
            android:name=".AutoExitReceiver"
            android:exported="false" />

        <!-- 蓝牙任务闹钟的到点入口：到点关蓝牙 / 到点开蓝牙 -->
        <receiver
            android:name=".BluetoothTaskReceiver"
            android:exported="false" />

        <!-- 开机后重排自动关闭闹钟，系统广播必须对外导出才能收到 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
